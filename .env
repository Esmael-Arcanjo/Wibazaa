# ==========================================
# 💻 CONFIGURAÇÕES DO FRONTEND (React)
# ==========================================
# Endereço base da sua API/Backend que o React irá consumir
REACT_APP_BACKEND_URL=http://localhost:8000 

# Porta do WebSocket de desenvolvimento do React (WDS = Webpack Dev Server).
# O valor "0" força o servidor a usar a mesma porta do navegador para evitar erros de conexão no Hot Reload
WDS_SOCKET_PORT=0

# Ativa ou desativa a verificação de saúde (health check) da aplicação
ENABLE_HEALTH_CHECK=false